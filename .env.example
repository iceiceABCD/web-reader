DATABASE_URL=postgres://user:password@host/database?sslmode=require
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=https://your-domain.vercel.app

# Application mode: "server" (multi-user, registration allowed) or "private" (single user, no registration)
APP_MODE=server

# Admin credentials (only used when APP_MODE=private, auto-create on first login)
ADMIN_EMAIL=
ADMIN_PASSWORD=